# video-pipeline 共享配置（fetch.sh / dub.sh 共用）

# 路径
VIDEO_DIR="/home/loomz/视频"
DOWNLOAD_DIR="/home/loomz/视频/downloads"
OUTPUT_DIR="/home/loomz/视频/outputs"
PYVIDEOTRANS_DIR="/home/loomz/workspace/money_code/videotrans/pyvideotrans"

# llama-swap 模型
SWAP_BASE="http://127.0.0.1:8080"
TRANSLATE_MODEL="qwen3.8-27b"
# TTS 引擎: "s2-pro"=fish-speech S2 Pro(走 llama-swap, 默认); "auk"=AuK zero-shot(本地 shim, 见下)
TTS_MODEL="s2-pro"
ASR_MODEL="large-v3"

# AuK 引擎 (TTS_MODEL="auk" 时生效)
AUK_DIR="/home/loomz/workspace/money_code/videotrans/AuK"
# 0=AuK base(32步, 质量高) 1=AuK-Flash(4步蒸馏, 快~8x)
AUK_FLASH="0"
AUK_SHIM_PORT=5998

# pyvideotrans 参数
TRANSLATE_TYPE=9
# TTS_TYPE: 30=Fish TTS(s2-pro 用); TTS_MODEL=auk 时 dub.sh 自动改用 36(AuK 专用, 隔离 TTS 缓存)
TTS_TYPE=30
# 音色: "clone"=克隆原视频英文说话人(中文带外国口音);
#       其它值=中文参考音色, 文件放 pyvideotrans/f5-tts/<VOICE_ROLE> (10-20s 干净中文人声)
VOICE_ROLE="clone"
# 参考音色的文字稿 (VOICE_ROLE 非 clone 时必填, 即那段参考音频里说的话)
VOICE_REF_TEXT=""
SUBTITLE_TYPE=0
SEGMENT_MIN=30
# TTS 并发线程数 (fish 服务端 GPU 推理串行, 并发只重叠客户端开销, 3-5 为宜)
TTS_THREADS=4

# 下载 cookies（留空=不用；填 cookies.txt 路径）
WEIBO_COOKIES=""
BILI_COOKIES=""
DOUYIN_COOKIES=""
YOUTUBE_COOKIES=""
TWITTER_COOKIES=""
